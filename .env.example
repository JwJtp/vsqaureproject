# ───────────────────────────────────────────────────────────────
# V Square Projects — AI Sales Command Center  (Nexobova HQ)
# Copy to .env.local for local dev. In Vercel add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ───────────────────────────────────────────────────────────────

# auto = LIVE when Supabase keys exist, otherwise DEMO.  demo = always demo.  live = fail if Supabase missing.
APP_MODE=auto
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (database + auth). Service role key is SERVER-ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key for encrypting integration credentials at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# OpenAI — without it the built-in bilingual simulator is used (DEMO).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Meta WhatsApp Business Cloud API — without these WhatsApp runs in DEMO MODE (simulated, never "delivered").
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Facebook Lead Ads + Instagram messaging (long-lived Page access token)
META_PAGE_ACCESS_TOKEN=

# Server-to-server lead webhook (CRMs, ad tools). Callers sign the body with HMAC-SHA256.
LEAD_WEBHOOK_SECRET=
# Browser origins allowed to post the public enquiry form
ALLOWED_ORIGINS=https://www.vsquareprojects.in,https://vsquareprojects.in

# Scheduler: cron calls /api/jobs/run with  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional admin alerts
ADMIN_ALERT_WHATSAPP=
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
ADMIN_ALERT_EMAIL=
